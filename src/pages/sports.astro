---
import Layout from "../layouts/Layout.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import { getFacilities, getSettings, waUrl, imageFor } from "../lib/directus";

const clockIcon = "M12 7v5l3 2";
const usersIcon =
  "M17 20h5v-1a4 4 0 00-3-3.87M9 20H4v-1a4 4 0 013-3.87m5-2.13a4 4 0 100-8 4 4 0 000 8zm7 1a3 3 0 100-6 3 3 0 000 6z";

const facilities = await getFacilities();
const settings = await getSettings();
const [padel, basketball] = facilities;

// No dedicated booking page — "Book Court" opens WhatsApp (number from CMS site_settings).
const bookingUrl = waUrl(settings.whatsapp_number, "Halo Fullbelly Bogor, saya ingin booking lapangan");
const badgeList = (s?: string) =>
  s ? s.split(",").map((x) => x.trim()).filter(Boolean) : [];
---

<Layout
  activeNav="sports"
  title="Sports — Fullbelly Bogor"
  description="Premium sporting facilities at Fullbelly Bogor — padel and basketball courts built for performance."
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div class="grain absolute inset-0 -z-10">
      <ImagePlaceholder
        label="Photo: Arena"
        src="https://images.unsplash.com/photo-1763854413165-1713bc5a7f4a?w=1920&q=75&auto=format&fit=crop"
        alt="Dark dramatic indoor arena with spotlights"
        class="h-full w-full"
      />
      <div class="absolute inset-0 bg-linear-to-b from-ink/70 via-ink/60 to-ink"></div>
    </div>

    <div class="mx-auto max-w-3xl px-6 py-28 text-center lg:py-40">
      <h1 class="text-[clamp(2.25rem,8vw,4.5rem)] leading-[1.02] font-extrabold text-brand-soft">
        Play with Intensity.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-white/70 sm:text-lg">
        Experience premium sporting facilities designed for performance. From high-energy padel
        to competitive basketball, find your arena at Fullbelly Bogor.
      </p>
    </div>
  </section>

  <!-- Our Facilities -->
  <section class="bg-ink px-6 py-20 lg:px-10 lg:py-28">
    <div class="mx-auto max-w-6xl">
      <p class="eyebrow text-brand">The Arena</p>
      <h2 class="mt-4 text-4xl font-extrabold text-white sm:text-5xl">Our Facilities</h2>
      <p class="mt-3 text-white/55">World-class courts for every player.</p>

      <div class="mt-12 grid gap-6 lg:grid-cols-[2fr_1fr]">
        <!-- Padel Court (large) -->
        {
          padel && (
            <article class="group relative flex min-h-105 flex-col justify-end overflow-hidden rounded-2xl ring-1 ring-white/10 transition-all duration-300 hover:ring-white/25">
              <div class="absolute inset-0 overflow-hidden">
                <ImagePlaceholder
                  label={padel.name}
                  src={imageFor(padel)}
                  alt={padel.name}
                  class="h-full w-full transition-transform duration-700 ease-out group-hover:scale-105"
                />
              </div>
              <div class="absolute inset-0 bg-linear-to-t from-black/92 from-10% via-black/40 via-70% to-black/20" />

              <div class="relative p-7">
                <div class="flex flex-wrap gap-2">
                  {badgeList(padel.badges).map((b, i) => (
                    <span
                      class:list={[
                        "rounded-full px-3 py-1 text-xs font-semibold",
                        i === 0
                          ? "bg-white/90 text-ink"
                          : "bg-black/50 text-white ring-1 ring-white/20",
                      ]}
                    >
                      {b}
                    </span>
                  ))}
                </div>
                <h3 class="mt-4 text-3xl font-bold text-white">{padel.name}</h3>
                <p class="mt-2 text-white/65">{padel.tagline}</p>

                <div class="mt-6 border-t border-white/15 pt-5">
                  <div class="flex flex-wrap items-center justify-between gap-4">
                    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-white/70">
                      <span class="inline-flex items-center gap-2">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 text-brand">
                          <circle cx="12" cy="12" r="9" />
                          <path stroke-linecap="round" stroke-linejoin="round" d={clockIcon} />
                        </svg>
                        {padel.hours}
                      </span>
                      {padel.capacity && (
                        <span class="inline-flex items-center gap-2">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 text-brand">
                            <path stroke-linecap="round" stroke-linejoin="round" d={usersIcon} />
                          </svg>
                          {padel.capacity}
                        </span>
                      )}
                    </div>
                    <a
                      href={bookingUrl}
                      target="_blank"
                      rel="noopener"
                      class="rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-brand/20 transition-all hover:bg-brand-dark active:translate-y-px"
                    >
                      Book Court
                    </a>
                  </div>
                </div>
              </div>
            </article>
          )
        }

        <!-- Basketball Court (small) -->
        {
          basketball && (
            <article class="group relative flex min-h-105 flex-col justify-end overflow-hidden rounded-2xl ring-1 ring-white/10 transition-all duration-300 hover:ring-white/25">
              <div class="absolute inset-0 overflow-hidden">
                <ImagePlaceholder
                  label={basketball.name}
                  src={imageFor(basketball)}
                  alt={basketball.name}
                  class="h-full w-full transition-transform duration-700 ease-out group-hover:scale-105"
                />
              </div>
              <div class="absolute inset-0 bg-linear-to-t from-black/92 from-10% via-black/40 via-70% to-black/20" />

              <div class="relative p-7">
                {badgeList(basketball.badges)[0] && (
                  <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-ink">
                    {badgeList(basketball.badges)[0]}
                  </span>
                )}
                <h3 class="mt-4 text-3xl font-bold text-white">{basketball.name}</h3>
                <p class="mt-2 text-sm text-white/65">{basketball.tagline}</p>

                <div class="mt-5 flex items-center gap-2 text-sm text-white/70">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4 text-brand">
                    <circle cx="12" cy="12" r="9" />
                    <path stroke-linecap="round" stroke-linejoin="round" d={clockIcon} />
                  </svg>
                  {basketball.hours}
                </div>

                <a
                  href={bookingUrl}
                  target="_blank"
                  rel="noopener"
                  class="mt-5 block rounded-full border border-white/25 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/5"
                >
                  Book Court
                </a>
              </div>
            </article>
          )
        }
      </div>
    </div>
  </section>
</Layout>
