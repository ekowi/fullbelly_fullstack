---
import { waUrl, type SiteSettings } from "../lib/directus";

interface Props {
  settings: SiteSettings;
}
const { settings } = Astro.props;
const year = new Date().getFullYear();

const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Menu", href: "/menu" },
  { label: "Sports", href: "/sports" },
  { label: "Gallery", href: "/gallery" },
];

const waHref = waUrl(settings.whatsapp_number, "Halo Fullbelly Bogor");
---

<footer class="border-t border-white/10 bg-black">
  <div class="mx-auto max-w-7xl px-6 py-14 lg:px-10">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1.4fr]">
      <div>
        <p class="font-display text-lg font-bold text-brand">Fullbelly Bogor</p>
        <p class="mt-3 max-w-xs text-sm text-white/50">
          {settings.footer_tagline}
        </p>
        <div class="mt-5 flex gap-3">
          <a
            href="#"
            aria-label={`Fullbelly Bogor on Instagram (${settings.instagram_handle})`}
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-white/60 transition-colors hover:border-brand hover:text-brand"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a
            href={waHref}
            target="_blank"
            rel="noopener"
            aria-label="Chat with Fullbelly Bogor on WhatsApp"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 text-white/60 transition-colors hover:border-brand hover:text-brand"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"
              />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <p class="text-sm font-semibold text-white">Explore</p>
        <nav class="mt-4 flex flex-col gap-2.5 text-sm text-white/50">
          {
            quickLinks.map((link) => (
              <a href={link.href} class="w-fit hover:text-white">
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div>
        <p class="text-sm font-semibold text-white">Visit Us</p>
        <address class="mt-4 max-w-55 text-sm text-white/50 not-italic">
          {settings.address_line1}, {settings.address_line2}
        </address>
        <div class="mt-4 space-y-1 text-sm text-white/50">
          <p>Restaurant: {settings.restaurant_hours}</p>
          <p>Sports Arena: {settings.arena_hours}</p>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-white/40 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Fullbelly Bogor. All rights reserved.</p>
      <a href="#" class="hover:text-white/70">Privacy Policy</a>
    </div>
  </div>
</footer>
