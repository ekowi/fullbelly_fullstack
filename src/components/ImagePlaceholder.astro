---
interface Props {
  label: string;
  src?: string;
  alt?: string;
  class?: string;
}
const { label, src, alt = label, class: className = "" } = Astro.props;
---

{
  src ? (
    <img src={src} alt={alt} class={`h-full w-full object-cover ${className}`} />
  ) : (
    <div
      class={`relative flex items-center justify-center overflow-hidden bg-gradient-to-br from-white/10 via-white/5 to-black/60 ${className}`}
    >
      <span class="rounded-full border border-white/15 bg-black/40 px-3 py-1 text-xs font-medium uppercase tracking-wide text-white/50">
        {label}
      </span>
    </div>
  )
}
