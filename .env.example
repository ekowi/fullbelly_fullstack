# Copy to .env and adjust. .env is gitignored.
# For PRODUCTION: generate strong random values for every secret below.

# --- Postgres ---
DB_USER=fullbelly
DB_PASSWORD=change-me-dev-password
DB_DATABASE=fullbelly

# --- Directus ---
# KEY & SECRET must be long random strings (e.g. `openssl rand -hex 32`).
DIRECTUS_KEY=dev-key-change-me-0000000000000000
DIRECTUS_SECRET=dev-secret-change-me-00000000000000000000
ADMIN_EMAIL=admin@fullbelly.com
ADMIN_PASSWORD=admin12345

# --- Astro build-time fetch (used by the site to read from Directus) ---
DIRECTUS_URL=http://localhost:8055
# Optional: a read-only static token for the site (leave blank to use public role)
DIRECTUS_TOKEN=

# PIC (content editor) account — non-admin, hanya edit konten.
PIC_EMAIL=pic@fullbelly.com
PIC_PASSWORD=change-me-pic-password

# --- Analytics (OPSIONAL fallback; sumber utama = CMS Site Settings) ---
# Kosong = mati. Diisi CMS lebih diutamakan daripada nilai di sini.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
